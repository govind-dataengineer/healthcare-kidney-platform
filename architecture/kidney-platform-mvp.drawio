<mxfile host="app.diagrams.net" modified="2026-09-22T00:00:00.000Z" agent="Codex" version="26.0.16" type="device">
  <diagram id="kidney-mvp" name="MVP streaming architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Kidney Care Analytics Platform — MVP Streaming Architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Local-first AWS-shaped environment (Floci) · synthetic data only · one-command fresh runs" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="42" y="60" width="850" height="28" as="geometry"/></mxCell>
        <mxCell id="control" value="Developer control plane\n&lt;b&gt;make start&lt;/b&gt; · &lt;b&gt;make stop&lt;/b&gt; · &lt;b&gt;make reset&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#374151;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="1110" y="30" width="370" height="62" as="geometry"/></mxCell>
        <mxCell id="floci" value="FLOCI — local AWS emulator" style="swimlane;html=1;rounded=1;startSize=34;horizontal=1;fillColor=#FFF7ED;strokeColor=#F97316;fontColor=#9A3412;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="35" y="120" width="1450" height="550" as="geometry"/></mxCell>
        <mxCell id="sim" value="&lt;b&gt;APD Device Simulator&lt;/b&gt;\nPython service\n\nAccelerated overnight replay\n• therapy_started\n• initial_drain\n• cycle events\n• last_fill\n• therapy_completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=14;spacing=12;" vertex="1" parent="floci"><mxGeometry x="35" y="110" width="225" height="245" as="geometry"/></mxCell>
        <mxCell id="kinesis" value="&lt;b&gt;Amazon Kinesis&lt;/b&gt;\ntherapy-events stream\n\nPartition key: device_id\nOrdered events per device\nReplayable event log" style="shape=mxgraph.aws4.kinesis;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontColor=#581C87;fontSize=14;spacing=12;" vertex="1" parent="floci"><mxGeometry x="345" y="135" width="210" height="190" as="geometry"/></mxCell>
        <mxCell id="lambda" value="&lt;b&gt;AWS Lambda&lt;/b&gt;\nstream validator &amp; raw writer\n\nValidate envelope\nReject malformed events\nPersist immutable raw JSON" style="shape=mxgraph.aws4.lambda;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;spacing=12;" vertex="1" parent="floci"><mxGeometry x="640" y="135" width="225" height="190" as="geometry"/></mxCell>
        <mxCell id="raws3" value="&lt;b&gt;Amazon S3&lt;/b&gt;\nraw landing zone\n\n/run_id=…/\ndevice_id=…/\ndt=YYYY-MM-DD/\n\nImmutable JSON events" style="shape=mxgraph.aws4.s3;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;spacing=12;" vertex="1" parent="floci"><mxGeometry x="955" y="125" width="215" height="210" as="geometry"/></mxCell>
        <mxCell id="processor" value="&lt;b&gt;Continuous processor&lt;/b&gt;\nPython micro-batch service\n\nDiscovers new raw objects\nLoads Bronze tables\nTriggers dbt build\nNo manual pipeline steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontSize=14;spacing=12;" vertex="1" parent="floci"><mxGeometry x="1230" y="135" width="190" height="190" as="geometry"/></mxCell>
        <mxCell id="warehouse" value="Local analytics warehouse" style="swimlane;html=1;rounded=1;startSize=30;horizontal=1;fillColor=#F9FAFB;strokeColor=#64748B;fontColor=#334155;fontStyle=1;fontSize=15;" vertex="1" parent="floci"><mxGeometry x="300" y="400" width="920" height="120" as="geometry"/></mxCell>
        <mxCell id="bronze" value="&lt;b&gt;DuckDB Bronze&lt;/b&gt;\nRaw event records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#CA8A04;fontColor=#713F12;fontSize=14;spacing=9;" vertex="1" parent="warehouse"><mxGeometry x="25" y="45" width="190" height="55" as="geometry"/></mxCell>
        <mxCell id="silver" value="&lt;b&gt;dbt Silver&lt;/b&gt;\nTyped · deduplicated · sessions rebuilt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#6B7280;fontColor=#374151;fontSize=14;spacing=9;" vertex="1" parent="warehouse"><mxGeometry x="360" y="45" width="225" height="55" as="geometry"/></mxCell>
        <mxCell id="gold" value="&lt;b&gt;dbt Gold&lt;/b&gt;\nTherapy KPIs &amp; analytics marts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#D97706;fontColor=#78350F;fontSize=14;spacing=9;" vertex="1" parent="warehouse"><mxGeometry x="700" y="45" width="190" height="55" as="geometry"/></mxCell>
        <mxCell id="viewer" value="&lt;b&gt;Learning &amp; observability&lt;/b&gt;\nAWS CLI · stream inspection · Lambda logs\nDuckDB queries · dbt lineage &amp; tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#374151;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="310" y="710" width="540" height="92" as="geometry"/></mxCell>
        <mxCell id="future" value="&lt;b&gt;Future: agentic data assistant&lt;/b&gt;\nInvestigates pipeline health, DQ failures, lineage and KPI changes\nHuman-reviewed; never autonomous clinical decision-making" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontColor=#581C87;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="925" y="710" width="560" height="92" as="geometry"/></mxCell>
